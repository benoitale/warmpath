{
  "name": "warmpath",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate:graph && tsc -b && vite build",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "validate:graph": "tsx scripts/validate-graph.ts",
    "collect:graph": "tsx scripts/collect/build-graph.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.24",
    "eslint": "^9.39.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "postcss": "^8.5.6",
    "prettier": "^3.8.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.48.1",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
